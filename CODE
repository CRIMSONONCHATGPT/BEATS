font-size: 16px;
font-weight: 700;
color: #ffb3c1;
background: radial-gradient(circle at 30% 30%, rgba(255, 71, 87, 0.35), rgba(80, 10, 22, 0.8));
border-color: rgba(255, 99, 71, 0.5);
