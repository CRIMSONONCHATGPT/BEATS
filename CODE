#toast {
position: fixed;
top: 18px;
right: 18px;
padding: 12px 16px;
border-radius: 10px;
background: rgba(8, 12, 22, 0.85);
color: #f5f7fb;
border: 1px solid rgba(255, 255, 255, 0.12);
